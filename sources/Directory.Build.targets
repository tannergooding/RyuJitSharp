<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Directory.Build.targets is automatically picked up and imported by
    Microsoft.Common.targets. This file needs to exist, even if empty so that
    files in the parent directory tree, with the same name, are not imported
    instead. The import fairly late and most other props/targets will have
    been imported beforehand. We also don't need to add ourselves to
    MSBuildAllProjects, as that is done by the file that imports us.
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.targets" />

  <PropertyGroup>
    <GeneratedRyuJitSubstitutionsFile Condition="'$(GeneratedRyuJitSubstitutionsFile)' == ''">$(IntermediateOutputPath)$(MSBuildProjectName).ILLink.Substitutions.$(RyuJitTargetRuntimeIdentifier).xml</GeneratedRyuJitSubstitutionsFile>
    <GeneratedRyuJitSubstitutionsInputsFile Condition="'$(GeneratedRyuJitSubstitutionsInputsFile)' == ''">$(GeneratedRyuJitSubstitutionsFile).inputs</GeneratedRyuJitSubstitutionsInputsFile>
    <GeneratedSkipLocalsInitFile Condition="'$(GeneratedSkipLocalsInitFile)' == ''">$(IntermediateOutputPath)$(MSBuildProjectName).SkipLocalsInit$(DefaultLanguageSourceExtension)</GeneratedSkipLocalsInitFile>
    <GeneratedSkipLocalsInitFileLines>
      <![CDATA[//------------------------------------------------------------------------------
// <auto-generated>
//     This code was generated by a tool.
//
//     Changes to this file may cause incorrect behavior and will be lost if
//     the code is regenerated.
// </auto-generated>
//------------------------------------------------------------------------------

[module: System.Runtime.CompilerServices.SkipLocalsInitAttribute]

// Generated by the MSBuild WriteLinesToFile class.]]>
    </GeneratedSkipLocalsInitFileLines>
  </PropertyGroup>

  <ItemGroup Condition="'$(Language)' == 'C#' and '@(RyuJitSubstitution)' != ''">
    <EmbeddedResource Include="$(GeneratedRyuJitSubstitutionsFile)" LogicalName="ILLink.Substitutions.xml" />
  </ItemGroup>

  <Target Name="PrepareRyuJitSubstitutionInputs"
          DependsOnTargets="PrepareForBuild"
          Condition="'$(Language)' == 'C#' and '@(RyuJitSubstitution)' != ''">
    <WriteLinesToFile Lines="@(RyuJitSubstitutionEnabled->'%(Identity)');@(RyuJitSubstitution->'%(Identity)|%(FixedValue)|%(ReturnType)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      File="$(GeneratedRyuJitSubstitutionsInputsFile)" />
  </Target>

  <Target Name="GenerateRyuJitSubstitutions"
          BeforeTargets="PrepareResources;BeforeCompile;CoreCompile"
          DependsOnTargets="PrepareForBuild;PrepareRyuJitSubstitutionInputs"
          Condition="'$(Language)' == 'C#' and '@(RyuJitSubstitution)' != ''"
          Inputs="$(MSBuildAllProjects);$(GeneratedRyuJitSubstitutionsInputsFile)"
          Outputs="$(GeneratedRyuJitSubstitutionsFile)">
    <PropertyGroup>
      <RyuJitSubstitutionEnabledNames>@(RyuJitSubstitutionEnabled)</RyuJitSubstitutionEnabledNames>
    </PropertyGroup>

    <ItemGroup>
      <RyuJitSubstitution Update="@(RyuJitSubstitution)" Value="false" />
      <RyuJitSubstitution Update="@(RyuJitSubstitution)"
                          Value="true"
                          Condition="'%(RyuJitSubstitution.FixedValue)' == '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(RyuJitSubstitutionEnabledNames)', '(^|;)%(RyuJitSubstitution.Identity)(;|$)'))" />
      <RyuJitSubstitution Update="@(RyuJitSubstitution)"
                          Value="%(RyuJitSubstitution.FixedValue)"
                          Condition="'%(RyuJitSubstitution.FixedValue)' != ''" />
      <RyuJitSubstitution Update="OPTIONAL_STATISTICS"
                          Value="true"
                          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(RyuJitSubstitutionEnabledNames)', '(^|;)(NODEBASH_STATS|COUNT_BASIC_BLOCKS|COUNT_AST_OPERS|CALL_ARG_STATS|MEASURE_NODE_SIZE|MEASURE_BLOCK_SIZE|MEASURE_PTRTAB_SIZE|MEASURE_FATAL|EMITTER_STATS)(;|$)'))" />
      <RyuJitSubstitution Update="@(RyuJitSubstitution)"
                          ReturnType="System.Boolean"
                          Condition="'%(RyuJitSubstitution.ReturnType)' == ''" />
      <RyuJitSubstitution Update="@(RyuJitSubstitution)"
                          Line="&lt;method signature=&quot;%(RyuJitSubstitution.ReturnType) get_%(RyuJitSubstitution.Identity)()&quot; body=&quot;stub&quot; value=&quot;%(RyuJitSubstitution.Value)&quot; /&gt;"
                          Condition="'%(RyuJitSubstitution.HasConfigurationGetter)' != 'false'" />
    </ItemGroup>

    <ItemGroup>
      <RyuJitSubstitutionLine Include="&lt;linker&gt;" />
      <RyuJitSubstitutionLine Include="  &lt;assembly fullname=&quot;RyuJitSharp&quot;&gt;" />
      <RyuJitSubstitutionLine Include="    &lt;type fullname=&quot;RyuJitSharp.Configuration&quot;&gt;" />
      <RyuJitSubstitutionLine Include="@(RyuJitSubstitution->'%(Line)')"
                              Condition="'%(RyuJitSubstitution.HasConfigurationGetter)' != 'false'" />
      <RyuJitSubstitutionLine Include="&lt;!-- &lt;method signature=&quot;%(RyuJitSubstitution.ReturnType) get_%(RyuJitSubstitution.Identity)()&quot; body=&quot;stub&quot; value=&quot;%(RyuJitSubstitution.Value)&quot; /&gt; --&gt;"
                              Condition="'%(RyuJitSubstitution.HasConfigurationGetter)' == 'false'" />
      <RyuJitSubstitutionLine Include="    &lt;/type&gt;" />
      <RyuJitSubstitutionLine Include="  &lt;/assembly&gt;" />
      <RyuJitSubstitutionLine Include="&lt;/linker&gt;" />
    </ItemGroup>

    <WriteLinesToFile Lines="@(RyuJitSubstitutionLine)" Overwrite="true" WriteOnlyWhenDifferent="true" File="$(GeneratedRyuJitSubstitutionsFile)" />
  </Target>

  <Target Name="GenerateSkipLocalsInit"
          BeforeTargets="BeforeCompile;CoreCompile"
          DependsOnTargets="PrepareForBuild"
          Condition="'$(Language)' == 'C#'"
          Inputs="$(MSBuildAllProjects)"
          Outputs="$(GeneratedSkipLocalsInitFile)">
    <WriteLinesToFile Lines="$(GeneratedSkipLocalsInitFileLines)" Overwrite="true" WriteOnlyWhenDifferent="true" File="$(GeneratedSkipLocalsInitFile)" />

    <ItemGroup>
      <Compile Include="$(GeneratedSkipLocalsInitFile)" />
    </ItemGroup>
  </Target>

</Project>
