    <RyuJitSubstitutionEnabled Include="HOST_UNIX" Condition="'$(RyuJitHostIsUnix)' == 'true'" />

    <RyuJitSubstitutionEnabled Include="HOST_ANDROID" Condition="'$(RyuJitHostOS)' == 'android'" />
    <RyuJitSubstitutionEnabled Include="HOST_BROWSER" Condition="'$(RyuJitHostOS)' == 'browser'" />
    <RyuJitSubstitutionEnabled Include="HOST_IOS" Condition="'$(RyuJitHostOS)' == 'ios'" />
    <RyuJitSubstitutionEnabled Include="HOST_FREEBSD" Condition="'$(RyuJitHostOS)' == 'freebsd'" />
    <RyuJitSubstitutionEnabled Include="HOST_HAIKU" Condition="'$(RyuJitHostOS)' == 'haiku'" />
    <RyuJitSubstitutionEnabled Include="HOST_ILLUMOS" Condition="'$(RyuJitHostOS)' == 'illumos'" />
    <RyuJitSubstitutionEnabled Include="HOST_LINUX" Condition="'$(RyuJitHostOS)' == 'linux'" />
    <RyuJitSubstitutionEnabled Include="HOST_LINUX_MUSL" Condition="'$(RyuJitHostOS)' == 'linux-musl'" />
    <RyuJitSubstitutionEnabled Include="HOST_MACCATALYST" Condition="'$(RyuJitHostOS)' == 'maccatalyst'" />
    <RyuJitSubstitutionEnabled Include="HOST_NETBSD" Condition="'$(RyuJitHostOS)' == 'netbsd'" />
    <RyuJitSubstitutionEnabled Include="HOST_OPENBSD" Condition="'$(RyuJitHostOS)' == 'openbsd'" />
    <RyuJitSubstitutionEnabled Include="HOST_OSX" Condition="'$(RyuJitHostOS)' == 'osx'" />
    <RyuJitSubstitutionEnabled Include="HOST_SUNOS" Condition="'$(RyuJitHostOS)' == 'sunos'" />
    <RyuJitSubstitutionEnabled Include="HOST_TVOS" Condition="'$(RyuJitHostOS)' == 'tvos'" />
    <RyuJitSubstitutionEnabled Include="HOST_UNIX" Condition="'$(RyuJitHostOS)' == 'unix'" />
    <RyuJitSubstitutionEnabled Include="HOST_WASI" Condition="'$(RyuJitHostOS)' == 'wasi'" />
    <RyuJitSubstitutionEnabled Include="HOST_WINDOWS" Condition="'$(RyuJitHostOS)' == 'win'" />
  </ItemGroup>

  <!-- Add substitution conditions for the target OS and architecture -->

  <ItemGroup>
    <RyuJitSubstitutionEnabled Include="TARGET_ARM" Condition="'$(RyuJitTargetIsArm)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="TARGET_ARMARCH" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="TARGET_XARCH" Condition="'$(RyuJitTargetIsXarch)' == 'true'" />

    <RyuJitSubstitutionEnabled Include="TARGET_ARMV6" Condition="'$(RyuJitTargetArchitecture)' == 'armv6'" />
    <RyuJitSubstitutionEnabled Include="TARGET_ARM64" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="TARGET_LOONGARCH64" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="TARGET_MIPS64" Condition="'$(RyuJitTargetArchitecture)' == 'mips64'" />
    <RyuJitSubstitutionEnabled Include="TARGET_POWERPC64" Condition="'$(RyuJitTargetArchitecture)' == 'ppc64le'" />
    <RyuJitSubstitutionEnabled Include="TARGET_RISCV64" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="TARGET_S390X" Condition="'$(RyuJitTargetArchitecture)' == 's390x'" />
    <RyuJitSubstitutionEnabled Include="TARGET_WASM" Condition="'$(RyuJitTargetArchitecture)' == 'wasm'" />
    <RyuJitSubstitutionEnabled Include="TARGET_WASM32" Condition="'$(RyuJitTargetArchitecture)' == 'wasm'" />
    <RyuJitSubstitutionEnabled Include="TARGET_AMD64" Condition="'$(RyuJitTargetArchitecture)' == 'x64'" />
    <RyuJitSubstitutionEnabled Include="TARGET_X86" Condition="'$(RyuJitTargetArchitecture)' == 'x86'" />

    <RyuJitSubstitutionEnabled Include="TARGET_32BIT" Condition="'$(RyuJitTargetIs32Bit)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="TARGET_64BIT" Condition="'$(RyuJitTargetIs64Bit)' == 'true'" />

    <RyuJitSubstitutionEnabled Include="TARGET_APPLE" Condition="'$(RyuJitTargetIsApple)' == 'true'" />
    <!-- Native target.h enables FEATURE_CFI_SUPPORT when TARGET_UNIX_POSSIBLY_SUPPORTED is set. -->
    <RyuJitSubstitutionEnabled Include="TARGET_UNIX" Condition="'$(RyuJitTargetIsUnix)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="TARGET_UNIX_POSSIBLY_SUPPORTED" Condition="'$(RyuJitTargetIsUnix)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_CFI_SUPPORT" Condition="'$(RyuJitTargetIsUnix)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="TARGET_OS_RUNTIMEDETERMINED" Condition="'$(RyuJitTargetOS)' == 'anyos'" />
    <RyuJitSubstitutionEnabled Include="TARGET_UNIX_POSSIBLY_SUPPORTED" Condition="'$(RyuJitTargetOS)' == 'anyos'" />
    <RyuJitSubstitutionEnabled Include="TARGET_WINDOWS_POSSIBLY_SUPPORTED" Condition="'$(RyuJitTargetOS)' == 'anyos'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_CFI_SUPPORT" Condition="'$(RyuJitTargetOS)' == 'anyos'" />
    <RyuJitSubstitutionEnabled Include="TARGET_ANDROID" Condition="'$(RyuJitTargetOS)' == 'android'" />
    <RyuJitSubstitutionEnabled Include="TARGET_BROWSER" Condition="'$(RyuJitTargetOS)' == 'browser'" />
    <RyuJitSubstitutionEnabled Include="TARGET_IOS" Condition="'$(RyuJitTargetOS)' == 'ios'" />
    <RyuJitSubstitutionEnabled Include="TARGET_FREEBSD" Condition="'$(RyuJitTargetOS)' == 'freebsd'" />
    <RyuJitSubstitutionEnabled Include="TARGET_HAIKU" Condition="'$(RyuJitTargetOS)' == 'haiku'" />
    <RyuJitSubstitutionEnabled Include="TARGET_ILLUMOS" Condition="'$(RyuJitTargetOS)' == 'illumos'" />
    <RyuJitSubstitutionEnabled Include="TARGET_LINUX" Condition="'$(RyuJitTargetOS)' == 'linux'" />
    <RyuJitSubstitutionEnabled Include="TARGET_LINUX_MUSL" Condition="'$(RyuJitTargetOS)' == 'linux-musl'" />
    <RyuJitSubstitutionEnabled Include="TARGET_MACCATALYST" Condition="'$(RyuJitTargetOS)' == 'maccatalyst'" />
    <RyuJitSubstitutionEnabled Include="TARGET_NETBSD" Condition="'$(RyuJitTargetOS)' == 'netbsd'" />
    <RyuJitSubstitutionEnabled Include="TARGET_OPENBSD" Condition="'$(RyuJitTargetOS)' == 'openbsd'" />
    <RyuJitSubstitutionEnabled Include="TARGET_OSX" Condition="'$(RyuJitTargetOS)' == 'osx'" />
    <RyuJitSubstitutionEnabled Include="TARGET_SUNOS" Condition="'$(RyuJitTargetOS)' == 'sunos'" />
    <RyuJitSubstitutionEnabled Include="TARGET_TVOS" Condition="'$(RyuJitTargetOS)' == 'tvos'" />
    <RyuJitSubstitutionEnabled Include="TARGET_OS_RUNTIMEDETERMINED" Condition="'$(RyuJitTargetOS)' == 'unix'" />
    <RyuJitSubstitutionEnabled Include="TARGET_UNIX_ANYOS" Condition="'$(RyuJitTargetOS)' == 'unix'" />
    <RyuJitSubstitutionEnabled Include="TARGET_UNIX_OS_RUNTIMEDETERMINED" Condition="'$(RyuJitTargetOS)' == 'unix'" />
    <RyuJitSubstitutionEnabled Include="TARGET_WASI" Condition="'$(RyuJitTargetOS)' == 'wasi'" />
    <RyuJitSubstitutionEnabled Include="TARGET_WINDOWS" Condition="'$(RyuJitTargetOS)' == 'win'" />
    <RyuJitSubstitutionEnabled Include="TARGET_WINDOWS_POSSIBLY_SUPPORTED" Condition="'$(RyuJitTargetOS)' == 'win'" />
  </ItemGroup>

  <!-- Add fixed host-based substitution conditions -->

  <ItemGroup>
    <RyuJitSubstitutionEnabled Include="BIGENDIAN" Condition="'$(RyuJitHostArchitecture)' == 's390x'" />
  </ItemGroup>

  <!-- Add fixed target-based substitution conditions -->

  <ItemGroup>
    <!-- ABIs -->
    <RyuJitSubstitutionEnabled Include="UNIX_ARM_ABI" Condition="'$(RyuJitTargetArchitecture)' == 'arm' and '$(RyuJitTargetIsUnix)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="OSX_ARM64_ABI" Condition="'$(RyuJitTargetArchitecture)' == 'arm64' and '$(RyuJitTargetIsApple)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="UNIX_AMD64_ABI" Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="WINDOWS_AMD64_ABI" Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' != 'true'" />
    <RyuJitSubstitutionEnabled Include="UNIX_X86_ABI" Condition="'$(RyuJitTargetArchitecture)' == 'x86' and '$(RyuJitTargetIsUnix)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="CONFIGURABLE_ARM_ABI"
                               Condition="'$(RyuJitTargetIsArm)' == 'true' and ('$(RyuJitTargetOS)' == 'anyos' or '$(RyuJitTargetOS)' == 'unix')" />

    <!-- ALIGN_SIMD_TYPES: Whether SIMD type locals are to be aligned -->
    <RyuJitSubstitutionEnabled Include="ALIGN_SIMD_TYPES" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="ALIGN_SIMD_TYPES" Condition="'$(RyuJitTargetArchitecture)' == 'x64'" />
    <RyuJitSubstitutionEnabled Include="ALIGN_SIMD_TYPES" Condition="'$(RyuJitTargetArchitecture)' == 'x86'" />

    <!-- CPU_HAS_BYTE_REGS -->
    <RyuJitSubstitutionEnabled Include="CPU_HAS_BYTE_REGS" Condition="'$(RyuJitTargetArchitecture)' == 'x86'" />

    <!-- CPU_LOAD_STORE_ARCH -->
    <RyuJitSubstitutionEnabled Include="CPU_LOAD_STORE_ARCH" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="CPU_LOAD_STORE_ARCH" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="CPU_LOAD_STORE_ARCH" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="CPU_LOAD_STORE_ARCH" Condition="'$(RyuJitTargetArchitecture)' == 'wasm'" />

    <!-- DOUBLE_ALIGN -->
    <!--   This aligns ESP to 0 mod 8 in function prolog, then uses ESP to reference locals, EBP to reference parameters. -->
    <!--   It only makes sense if frameless method support is on (frameless method support is now always on) -->
    <RyuJitSubstitutionEnabled Include="DOUBLE_ALIGN" Condition="'$(RyuJitTargetArchitecture)' == 'x86'" />

    <!-- EMIT_TRACK_STACK_DEPTH -->
    <RyuJitSubstitutionEnabled Include="EMIT_TRACK_STACK_DEPTH" Condition="'$(RyuJitTargetArchitecture)' != 'wasm'" />

    <!-- ETW_EBP_FRAMED: We cannot use REG as a scratch register and must create REG based frames for most methods-->
    <RyuJitSubstitutionEnabled Include="ETW_EBP_FRAMED" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="ETW_EBP_FRAMED" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="ETW_EBP_FRAMED" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="ETW_EBP_FRAMED" Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="ETW_EBP_FRAMED" Condition="'$(RyuJitTargetArchitecture)' == 'x86'" />

    <!-- FEATURE_ARG_SPLIT -->
    <!--   Arm64 Windows supports FEATURE_ARG_SPLIT, note this is different from the official Arm64 ABI. -->
    <!--   Case: splitting 16 byte struct between x7 and stack -->
    <!--   LoongArch64's ABI supports FEATURE_ARG_SPLIT which splitting 16 byte struct between a7 and stack. -->
    <RyuJitSubstitutionEnabled Include="FEATURE_ARG_SPLIT" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_ARG_SPLIT" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64' or '$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_ARG_SPLIT" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />

    <!-- FEATURE_FASTTAILCALL: Tail calls made as epilog+jmp -->
    <RyuJitSubstitutionEnabled Include="FEATURE_FASTTAILCALL" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_FASTTAILCALL" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_FASTTAILCALL" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_FASTTAILCALL" Condition="'$(RyuJitTargetArchitecture)' == 'wasm'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_FASTTAILCALL" Condition="'$(RyuJitTargetArchitecture)' == 'x64'" />

    <!-- FEATURE_FIXED_OUT_ARGS: Preallocate the outgoing arg area in the prolog -->
    <RyuJitSubstitutionEnabled Include="FEATURE_FIXED_OUT_ARGS" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_FIXED_OUT_ARGS" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_FIXED_OUT_ARGS" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_FIXED_OUT_ARGS" Condition="'$(RyuJitTargetArchitecture)' == 'x64'" />

    <!-- FEATURE_HAS_ZERO_REG: Target has a hardware "zero register" usable as a containable source for zero stores -->
    <RyuJitSubstitutionEnabled Include="FEATURE_HAS_ZERO_REG" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_HAS_ZERO_REG" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_HAS_ZERO_REG" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />

    <!-- FEATURE_HFA -->
    <RyuJitSubstitutionEnabled Include="FEATURE_HFA" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />

    <!-- FEATURE_HW_INTRINSICS -->
    <RyuJitSubstitutionEnabled Include="FEATURE_HW_INTRINSICS" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_HW_INTRINSICS" Condition="'$(RyuJitTargetIsXarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_HW_INTRINSICS" Condition="'$(RyuJitTargetArchitecture)' == 'wasm'" />

    <!-- FEATURE_IJW -->
    <RyuJitSubstitutionEnabled Include="FEATURE_IJW" Condition="'$(RyuJitTargetOS)' == 'win'" />

    <!-- FEATURE_IMPLICIT_BYREFS: Support for struct parameters passed via pointers to shadow copies -->
    <RyuJitSubstitutionEnabled Include="FEATURE_IMPLICIT_BYREFS" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_IMPLICIT_BYREFS" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_IMPLICIT_BYREFS" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_IMPLICIT_BYREFS" Condition="'$(RyuJitTargetArchitecture)' == 'wasm'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_IMPLICIT_BYREFS" Condition="'$(RyuJitTargetArchitecture)' == 'x64'" />

    <!-- FEATURE_LOOP_ALIGN -->
    <RyuJitSubstitutionEnabled Include="FEATURE_LOOP_ALIGN" Condition="'$(RyuJitTargetIsXarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_LOOP_ALIGN" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />

    <!-- FEATURE_MASKED_HW_INTRINSICS -->
    <RyuJitSubstitutionEnabled Include="FEATURE_MASKED_HW_INTRINSICS" Condition="'$(RyuJitTargetIsXarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MASKED_HW_INTRINSICS" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />

    <!-- FEATURE_MULTIREG_ARGS: Support for passing a single argument in more than one register -->
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_ARGS" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_ARGS" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_ARGS" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_ARGS" Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' == 'true'" />

    <!-- FEATURE_MULTIREG_ARGS_OR_RET: Support for passing and/or returning single values in more than one register -->
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_ARGS_OR_RET" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_ARGS_OR_RET" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_ARGS_OR_RET" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_ARGS_OR_RET" Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_ARGS_OR_RET" Condition="'$(RyuJitTargetArchitecture)' == 'x86'" />

    <!-- FEATURE_MULTIREG_RET: Support for returning a single value in more than one register -->
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_RET" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_RET" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_RET" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_RET" Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_RET" Condition="'$(RyuJitTargetArchitecture)' == 'x86'" />

    <!-- FEATURE_MULTIREG_STRUCT_PROMOTE: True when we want to promote fields of a multireg struct into registers -->
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_STRUCT_PROMOTE" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_STRUCT_PROMOTE" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_STRUCT_PROMOTE" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_STRUCT_PROMOTE" Condition="'$(RyuJitTargetArchitecture)' == 'wasm'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTIREG_STRUCT_PROMOTE" Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' == 'true'" />

    <!-- FEATURE_MULTITHREADING -->
    <RyuJitSubstitutionEnabled Include="FEATURE_MULTITHREADING" Condition="'$(RyuJitTargetArchitecture)' != 'wasm'" />

    <!-- FEATURE_PAL_ANSI -->
    <RyuJitSubstitutionEnabled Include="FEATURE_PAL_ANSI" Condition="'$(RyuJitTargetIsUnix)' == 'true'" />

    <!-- FEATURE_PARTIAL_SIMD_CALLEE_SAVE: Whether SIMD registers are partially saved at calls -->
    <RyuJitSubstitutionEnabled Include="FEATURE_PARTIAL_SIMD_CALLEE_SAVE" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_PARTIAL_SIMD_CALLEE_SAVE" Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' != 'true'" />

    <!-- FEATURE_REMAP_FUNCTION -->
    <RyuJitSubstitutionEnabled Include="FEATURE_REMAP_FUNCTION" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_REMAP_FUNCTION" Condition="'$(RyuJitTargetArchitecture)' == 'x64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_REMAP_FUNCTION" Condition="'$(RyuJitTargetArchitecture)' == 'x86' and '$(RyuJitTargetOS)' == 'win'" />

    <!-- FEATURE_SIMD -->
    <RyuJitSubstitutionEnabled Include="FEATURE_SIMD" Condition="'$(RyuJitTargetIsXarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_SIMD" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_SIMD" Condition="'$(RyuJitTargetArchitecture)' == 'wasm'" />

    <!-- FEATURE_TAILCALL_OPT: opportunistic Tail calls (i.e. without ".tail" prefix) made as fast tail calls -->
    <RyuJitSubstitutionEnabled Include="FEATURE_TAILCALL_OPT" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_TAILCALL_OPT" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_TAILCALL_OPT" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_TAILCALL_OPT" Condition="'$(RyuJitTargetArchitecture)' == 'x64'" />

    <!-- FEATURE_TAILCALL_OPT_SHARED_RETURN -->
    <!--   Enable tail call opt for the following IL pattern -->
    <!--       call someFunc -->
    <!--       jmp/jcc RetBlock -->
    <!--       ... -->
    <!--    RetBlock: -->
    <!--       ret -->
    <RyuJitSubstitutionEnabled Include="FEATURE_TAILCALL_OPT_SHARED_RETURN" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_TAILCALL_OPT_SHARED_RETURN" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_TAILCALL_OPT_SHARED_RETURN" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="FEATURE_TAILCALL_OPT_SHARED_RETURN" Condition="'$(RyuJitTargetArchitecture)' == 'x64'" />

    <!-- HAS_FIXED_REGISTER_SET -->
    <RyuJitSubstitutionEnabled Include="HAS_FIXED_REGISTER_SET" Condition="'$(RyuJitTargetArchitecture)' != 'wasm'" />

    <!-- HAS_MORE_THAN_64_REGISTERS -->
    <RyuJitSubstitutionEnabled Include="HAS_MORE_THAN_64_REGISTERS" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="HAS_MORE_THAN_64_REGISTERS" Condition="'$(RyuJitTargetArchitecture)' == 'x64'" />

    <!-- JIT32_GCENCODER -->
    <RyuJitSubstitutionEnabled Include="JIT32_GCENCODER" Condition="'$(RyuJitTargetArchitecture)' == 'x86'" />

    <!-- LOWER_DECOMPOSE_LONGS: Decompose TYP_LONG operations into (typically two) TYP_INT ones -->
    <RyuJitSubstitutionEnabled Include="LOWER_DECOMPOSE_LONGS" Condition="'$(RyuJitTargetArchitecture)' == 'arm'" />
    <RyuJitSubstitutionEnabled Include="LOWER_DECOMPOSE_LONGS" Condition="'$(RyuJitTargetArchitecture)' == 'x86'" />

    <!-- USE_HELPERS_FOR_INT_DIV: ARMv7A does not guarantee SDIV/UDIV support. -->
    <RyuJitSubstitutionEnabled Include="USE_HELPERS_FOR_INT_DIV" Condition="'$(RyuJitTargetArchitecture)' == 'arm'" />

    <!-- MULTIREG_HAS_SECOND_GC_RET -->
    <RyuJitSubstitutionEnabled Include="MULTIREG_HAS_SECOND_GC_RET" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="MULTIREG_HAS_SECOND_GC_RET" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="MULTIREG_HAS_SECOND_GC_RET" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="MULTIREG_HAS_SECOND_GC_RET" Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' == 'true'" />

    <!-- NOGC_WRITE_BARRIERS: We have specialized WriteBarrier JIT Helpers that DO-NOT trash the RBM_CALLEE_TRASH registers -->
    <RyuJitSubstitutionEnabled Include="NOGC_WRITE_BARRIERS" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="NOGC_WRITE_BARRIERS" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="NOGC_WRITE_BARRIERS" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="NOGC_WRITE_BARRIERS" Condition="'$(RyuJitTargetArchitecture)' == 'x86'" />

    <!-- PROFILING_SUPPORTED -->
    <RyuJitSubstitutionEnabled Include="PROFILING_SUPPORTED" Condition="'$(RyuJitTargetArchitecture)' != 'wasm' or '$(RyuJitEnableWasmProfilingTests)' == 'true'" />

    <!-- SWIFT_SUPPORT -->
    <RyuJitSubstitutionEnabled Include="SWIFT_SUPPORT" Condition="'$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="SWIFT_SUPPORT" Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' == 'true'" />

    <!-- REGMASK_BITS_32 -->
    <RyuJitSubstitutionEnabled Include="REGMASK_BITS_32" Condition="'$(RyuJitTargetArchitecture)' == 'wasm'" />
    <RyuJitSubstitutionEnabled Include="REGMASK_BITS_32" Condition="'$(RyuJitTargetArchitecture)' == 'x86'" />

    <!-- REGMASK_BITS_64 -->
    <RyuJitSubstitutionEnabled Include="REGMASK_BITS_64" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="REGMASK_BITS_64" Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'" />
    <RyuJitSubstitutionEnabled Include="REGMASK_BITS_64" Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'" />
    <RyuJitSubstitutionEnabled Include="REGMASK_BITS_64" Condition="'$(RyuJitTargetArchitecture)' == 'x64'" />

    <!-- USER_ARGS_COME_LAST -->
    <RyuJitSubstitutionEnabled Include="USER_ARGS_COME_LAST" Condition="'$(RyuJitTargetArchitecture)' != 'x86'" />

    <!-- USE_PER_FRAME_PINVOKE_INIT -->
    <RyuJitSubstitutionEnabled Include="USE_PER_FRAME_PINVOKE_INIT" Condition="'$(RyuJitTargetIs64Bit)' == 'true'" />
  </ItemGroup>

  <!-- Substitution values that are on by default -->

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- DUMP_FLOWGRAPHS: Support for creating Xml Flowgraph reports in *.fgx files -->
    <RyuJitSubstitutionEnabled Include="DUMP_FLOWGRAPHS" />

    <!-- DUMP_GC_TABLES -->
    <RyuJitSubstitutionEnabled Include="DUMP_GC_TABLES" />

    <!-- LATE_DISAM -->
    <RyuJitSubstitutionEnabled Include="LATE_DISASM" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="LATE_DISASM" Condition="'$(RyuJitTargetIsXarch)' == 'true'" />

    <!-- LOOP_HOIST_STATS: Collect loop hoisting stats. -->
    <RyuJitSubstitutionEnabled Include="LOOP_HOIST_STATS" />

    <!-- OPT_CONFIG -->
    <RyuJitSubstitutionEnabled Include="OPT_CONFIG" />

    <!-- TRACK_ENREG_STATS: Collect enregistration stats -->
    <RyuJitSubstitutionEnabled Include="TRACK_ENREG_STATS" />

    <!-- TRACK_LSRA_STATS: Collect LSRA stats -->
    <RyuJitSubstitutionEnabled Include="TRACK_LSRA_STATS" />

    <!-- USE_COREDISTOOLS -->
    <RyuJitSubstitutionEnabled Include="USE_COREDISTOOLS" Condition="'$(RyuJitTargetIsArmarch)' == 'true'" />
    <RyuJitSubstitutionEnabled Include="USE_COREDISTOOLS" Condition="'$(RyuJitTargetIsXarch)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- EMIT_GENERATE_GCINFO: Required GC liveness and metadata support in all configurations. -->
    <RyuJitSubstitutionEnabled Include="EMIT_GENERATE_GCINFO" />

    <!-- CSE_CONSTS: Enable if we want to CSE constants -->
    <RyuJitSubstitutionEnabled Include="CSE_CONSTS" />

    <!-- FEATURE_JIT_METHOD_PERF -->
    <RyuJitSubstitutionEnabled Include="FEATURE_JIT_METHOD_PERF" />

    <!-- FEATURE_ON_STACK_REPLACEMENT -->
    <RyuJitSubstitutionEnabled Include="FEATURE_ON_STACK_REPLACEMENT" />

    <!-- FEATURE_READYTORUN -->
    <RyuJitSubstitutionEnabled Include="FEATURE_READYTORUN" />

    <!-- FEATURE_STRUCTPROMOTE: JIT Optimization to promote fields of structs into registers -->
    <RyuJitSubstitutionEnabled Include="FEATURE_STRUCTPROMOTE" />

    <!-- FEATURE_USE_ASM_GC_WRITE_BARRIERS -->
    <RyuJitSubstitutionEnabled Include="FEATURE_USE_ASM_GC_WRITE_BARRIERS" />

    <!-- FEATURE_VN_TRACE_APPLY_SELECTORS: This controls extra tracing of the "evaluation" of "VNF_MapSelect" functions. -->
    <RyuJitSubstitutionEnabled Include="FEATURE_VN_TRACE_APPLY_SELECTORS" />

    <!-- FUNC_INFO_LOGGING: Support dumping function info to a file. In retail, only NYIs, with no function name, are dumped -->
    <RyuJitSubstitutionEnabled Include="FUNC_INFO_LOGGING" />

    <!-- REARRANGE_ADDS -->
    <RyuJitSubstitutionEnabled Include="REARRANGE_ADDS" />
  </ItemGroup>

  <!-- Substitution values that are off by default -->

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <RyuJitSubstitutionEnabled Include="LATE_DISASM" Condition="'$(RyuJitEnableArm64LateDisasm)' == 'true' and '$(RyuJitTargetArchitecture)' == 'arm64'" />
    <RyuJitSubstitutionEnabled Include="USE_COREDISTOOLS" Condition="'$(RyuJitEnableArm64LateDisasm)' == 'true' and '$(RyuJitTargetArchitecture)' == 'arm64'" />
  </ItemGroup>

  <ItemGroup>
