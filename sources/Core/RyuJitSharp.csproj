    <DefineConstants Condition="'$(RyuJitTargetIs32Bit)' == 'true'">$(DefineConstants);TARGET_32BIT</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetIs64Bit)' == 'true'">$(DefineConstants);TARGET_64BIT</DefineConstants>

    <DefineConstants Condition="'$(RyuJitTargetIsApple)' == 'true'">$(DefineConstants);TARGET_APPLE</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetIsUnix)' == 'true'">$(DefineConstants);TARGET_UNIX;TARGET_UNIX_POSSIBLY_SUPPORTED</DefineConstants>

    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'anyos'">$(DefineConstants);TARGET_OS_RUNTIMEDETERMINED;TARGET_UNIX_POSSIBLY_SUPPORTED;TARGET_WINDOWS_POSSIBLY_SUPPORTED</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'android'">$(DefineConstants);TARGET_ANDROID</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'browser'">$(DefineConstants);TARGET_BROWSER</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'ios'">$(DefineConstants);TARGET_IOS</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'freebsd'">$(DefineConstants);TARGET_FREEBSD</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'haiku'">$(DefineConstants);TARGET_HAIKU</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'illumos'">$(DefineConstants);TARGET_ILLUMOS</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'linux'">$(DefineConstants);TARGET_LINUX</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'linux-musl'">$(DefineConstants);TARGET_LINUX_MUSL</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'maccatalyst'">$(DefineConstants);TARGET_MACCATALYST</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'netbsd'">$(DefineConstants);TARGET_NETBSD</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetOS)' == 'openbsd'">$(DefineConstants);TARGET_OPENBSD</DefineConstants>
