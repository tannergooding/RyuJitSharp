    <RyuJitHostIsApple Condition="'$(RyuJitHostOS)' == 'tvos'">true</RyuJitHostIsApple>

    <RyuJitHostIsArm Condition="'$(RyuJitHostArchitecture)' == 'arm'">true</RyuJitHostIsArm>
    <RyuJitHostIsArm Condition="'$(RyuJitHostArchitecture)' == 'armv6'">true</RyuJitHostIsArm>

    <RyuJitHostIsArmarch Condition="'$(RyuJitHostIsArm)' == 'true'">true</RyuJitHostIsArmarch>
    <RyuJitHostIsArmarch Condition="'$(RyuJitHostArchitecture)' == 'arm64'">true</RyuJitHostIsArmarch>

    <RyuJitHostIsUnix Condition="'$(RyuJitHostOS)' != 'win'">true</RyuJitHostIsUnix>

    <RyuJitHostIsXarch Condition="'$(RyuJitHostArchitecture)' == 'x86'">true</RyuJitHostIsXarch>
    <RyuJitHostIsXarch Condition="'$(RyuJitHostArchitecture)' == 'x64'">true</RyuJitHostIsXarch>
  </PropertyGroup>

