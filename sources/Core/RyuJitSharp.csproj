    <!-- <RyuJitSubstitutionEnabled Include="MEASURE_FATAL" /> -->

    <!-- MEASURE_MEM_ALLOC: Collect managed allocation statistics. -->
    <!-- <RyuJitSubstitutionEnabled Include="MEASURE_MEM_ALLOC" /> -->

    <!-- MEASURE_NODE_SIZE: Collect stats about GenTree node allocations. -->
    <!-- <RyuJitSubstitutionEnabled Include="MEASURE_NODE_SIZE" /> -->

    <!-- MEASURE_NOWAY -->
    <!--   Enable code to count and rank individual noway_assert calls by occurrence. -->
    <!--   These asserts would be dynamically executed, but not necessarily fail. -->
    <!--   The provides some insight into the dynamic prevalence of these (if not a direct measure of their cost), which exist in non-DEBUG as well as DEBUG builds. -->
    <RyuJitSubstitutionEnabled Include="MEASURE_NOWAY" Condition="'$(RyuJitMeasureNoway)' == 'true'" />

    <!-- MEASURE_PTRTAB_SIZE: Collect stats about GC pointer table allocations. -->
    <!-- <RyuJitSubstitutionEnabled Include="MEASURE_PTRTAB_SIZE" /> -->

    <!-- NODEBASH_STATS: Collect stats on changed gtOper values in GenTree's. -->
