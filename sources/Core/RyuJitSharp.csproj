    <DefineConstants Condition="'$(RyuJitHostOS)' == 'osx'">$(DefineConstants);HOST_OSX</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostOS)' == 'sunos'">$(DefineConstants);HOST_SUNOS</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostOS)' == 'tvos'">$(DefineConstants);HOST_TVOS</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostOS)' == 'unix'">$(DefineConstants);HOST_UNIX</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostOS)' == 'wasi'">$(DefineConstants);HOST_WASI</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostOS)' == 'win'">$(DefineConstants);HOST_WINDOWS</DefineConstants>
  </PropertyGroup>
  
  <!-- Add define constants for the target OS and architecture -->

