    <DefineConstants Condition="'$(RyuJitHostArchitecture)' == 's390x'">$(DefineConstants);HOST_S390X</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostArchitecture)' == 'wasm'">$(DefineConstants);HOST_WASM;HOST_WASM32</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostArchitecture)' == 'x64'">$(DefineConstants);HOST_AMD64</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostArchitecture)' == 'x86'">$(DefineConstants);HOST_X86</DefineConstants>

    <DefineConstants Condition="'$(RyuJitHostIs32Bit)' == 'true'">$(DefineConstants);HOST_32BIT</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostIs64Bit)' == 'true'">$(DefineConstants);HOST_64BIT</DefineConstants>

    <DefineConstants Condition="'$(RyuJitHostIsApple)' == 'true'">$(DefineConstants);HOST_APPLE</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostIsUnix)' == 'true'">$(DefineConstants);HOST_UNIX</DefineConstants>
    
    <DefineConstants Condition="'$(RyuJitHostOS)' == 'android'">$(DefineConstants);HOST_ANDROID</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostOS)' == 'browser'">$(DefineConstants);HOST_BROWSER</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostOS)' == 'ios'">$(DefineConstants);HOST_IOS</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostOS)' == 'freebsd'">$(DefineConstants);HOST_FREEBSD</DefineConstants>
