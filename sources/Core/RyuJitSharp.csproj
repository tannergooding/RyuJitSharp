<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifiers>linux-arm64;linux-x64;osx-arm64;win-arm64;win-x64;win-x86</RuntimeIdentifiers>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <!-- CA1002: Do not expose generic lists -->
    <!-- CA1062: Validate arguments of public methods -->
    <!-- CA1700: Do not name enum values 'Reserved' -->
    <!-- CA1720: Identifiers should not contain type names -->
    <!-- CA1721: Property names should not match get methods -->
    <!-- CA1823: Avoid unused private fields -->
    <!-- CA2213: Disposable fields should be disposed -->
    <!-- CA2225: Operator overloads have named alternates -->
    <!-- CS0162: Unreachable code detected -->
    <!-- CS0169: The field is never used -->
    <!-- CS0414: The field is assigned but its value is never used -->
    <!-- CS0649: Field is never assigned to, and will always have its default value -->
    <!-- CS1591: Missing XML comment for publicly visible type or member 'Type_or_Member' -->
    <!-- IDE0044: Add readonly modifier -->
    <!-- IDE0060: Remove unused parameter -->
    <!-- IDE0130: Namespace does not match folder structure-->
    <NoWarn>$(NoWarn);CA1002;CA1062;CA1700;CA1720;CA1721;CA1823;CA2213;CA2225;CS0162;CS0169;CS0414;CS0649;CS1591;IDE0044;IDE0060;IDE0130</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <RyuJitHostRuntimeIdentifier>$(RuntimeIdentifier)</RyuJitHostRuntimeIdentifier>
    <RyuJitTargetRuntimeIdentifier Condition="'$(TargetRuntimeIdentifier)' == ''">$(RyuJitHostRuntimeIdentifier)</RyuJitTargetRuntimeIdentifier>
  </PropertyGroup>

  <!-- Extract the OS and architecture from the host runtime identifier -->

  <PropertyGroup>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-arm')) or $(RyuJitHostRuntimeIdentifier.Contains('-arm-'))">arm</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-armv6')) or $(RyuJitHostRuntimeIdentifier.Contains('-armv6-'))">armv6</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-arm64')) or $(RyuJitHostRuntimeIdentifier.Contains('-arm64-'))">arm64</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-loongarch64')) or $(RyuJitHostRuntimeIdentifier.Contains('-loongarch64-'))">loongarch64</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-mips64')) or $(RyuJitHostRuntimeIdentifier.Contains('-mips64-'))">mips64</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-ppc64le')) or $(RyuJitHostRuntimeIdentifier.Contains('-ppc64le-'))">ppc64le</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-riscv64')) or $(RyuJitHostRuntimeIdentifier.Contains('-riscv64-'))">riscv64</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-s390x')) or $(RyuJitHostRuntimeIdentifier.Contains('-s390x-'))">s390x</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-wasm')) or $(RyuJitHostRuntimeIdentifier.Contains('-wasm-'))">wasm</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-x64')) or $(RyuJitHostRuntimeIdentifier.Contains('-x64-'))">x64</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-x86')) or $(RyuJitHostRuntimeIdentifier.Contains('-x86-'))">x86</RyuJitHostArchitecture>

    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('android'))">android</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('browser'))">browser</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('ios'))">ios</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('freebsd'))">freebsd</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('haiku'))">haiku</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('illumos'))">illumos</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('linux'))">linux</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('linux-musl'))">linux-musl</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('maccatalyst'))">maccatalyst</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('netbsd'))">netbsd</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('openbsd'))">openbsd</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('osx'))">osx</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('sunos'))">sunos</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('tvos'))">tvos</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('unix'))">unix</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('wasi'))">wasi</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('win'))">win</RyuJitHostOS>

    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'arm'">true</RyuJitHostIs32Bit>
    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'armv6'">true</RyuJitHostIs32Bit>
    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'wasm'">true</RyuJitHostIs32Bit>
    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'x86'">true</RyuJitHostIs32Bit>

