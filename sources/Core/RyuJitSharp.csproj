    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'wasm'">$(DefineConstants);REGMASK_BITS_32</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'x86'">$(DefineConstants);REGMASK_BITS_32</DefineConstants>

    <!-- REGMASK_BITS_64 -->
    <DefineConstants Condition="'$(RyuJitTargetIsArmarch)' == 'true'">$(DefineConstants);REGMASK_BITS_64</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'">$(DefineConstants);REGMASK_BITS_64</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'">$(DefineConstants);REGMASK_BITS_64</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'x64'">$(DefineConstants);REGMASK_BITS_64</DefineConstants>

    <!-- USER_ARGS_COME_LAST -->
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' != 'x86'">$(DefineConstants);USER_ARGS_COME_LAST</DefineConstants>
    
    <!-- USE_PER_FRAME_PINVOKE_INIT -->
    <DefineConstants Condition="'$(RyuJitTargetIs64Bit)' == 'true'">$(DefineConstants);USE_PER_FRAME_PINVOKE_INIT</DefineConstants>
