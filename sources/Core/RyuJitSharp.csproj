<Project Sdk="Microsoft.NET.Sdk">

  <Target Name="GetRyuJitCompileConstants" Returns="$(DefineConstants)" />

  <ItemGroup>
    <InternalsVisibleTo Include="RyuJitSharp.UnitTests" />
    <InternalsVisibleTo Include="RyuJitSharp.Target.UnitTests" />
  </ItemGroup>

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifiers>linux-arm64;linux-x64;osx-arm64;win-arm64;win-x64;win-x86</RuntimeIdentifiers>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <!-- Release keeps debugger support and exception messages, but omits stack-trace data for size. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebuggerSupport>true</DebuggerSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == 'Checked'">
    <DebuggerSupport>true</DebuggerSupport>
    <StackTraceLineNumberSupport>true</StackTraceLineNumberSupport>
  </PropertyGroup>

  <PropertyGroup>
    <!-- CA1000: Do not declare static members on generic types -->
    <!-- CA1002: Do not expose generic lists -->
    <!-- CA1062: Validate arguments of public methods -->
    <!-- CA1700: Do not name enum values 'Reserved' -->
    <!-- CA1720: Identifiers should not contain type names -->
    <!-- CA1721: Property names should not match get methods -->
    <!-- CA1819: Properties should not return arrays -->
    <!-- CA1823: Avoid unused private fields -->
    <!-- CA2213: Disposable fields should be disposed -->
    <!-- CA2225: Operator overloads have named alternates -->
    <!-- CA5394: Do not use insecure randomness -->
    <!-- CS0162: Unreachable code detected -->
    <!-- CS0169: The field is never used -->
    <!-- CS0282: There is no defined ordering between fields in multiple declarations of partial class or struct 'type'. -->
    <!-- CS0414: The field is assigned but its value is never used -->
    <!-- CS0649: Field is never assigned to, and will always have its default value -->
    <!-- CS1591: Missing XML comment for publicly visible type or member 'Type_or_Member' -->
    <!-- CS8981: The type name only contains lower-cased ascii characters -->
    <!-- IDE0044: Add readonly modifier -->
    <!-- IDE0060: Remove unused parameter -->
    <!-- IDE0130: Namespace does not match folder structure-->
    <NoWarn>$(NoWarn);CA1000;CA1002;CA1062;CA1700;CA1720;CA1721;CA1819;CA1823;CA2213;CA2225;CA5394;CS0162;CS0169;CS0282;CS0414;CS0649;CS1591;CS8981;IDE0044;IDE0060;IDE0130</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <RyuJitHostRuntimeIdentifier>$(RuntimeIdentifier)</RyuJitHostRuntimeIdentifier>
    <RyuJitTargetRuntimeIdentifier Condition="'$(RyuJitTargetRuntimeIdentifier)' == '' and '$(TargetRuntimeIdentifier)' != ''">$(TargetRuntimeIdentifier)</RyuJitTargetRuntimeIdentifier>
    <RyuJitTargetRuntimeIdentifier Condition="'$(RyuJitTargetRuntimeIdentifier)' == ''">$(RyuJitHostRuntimeIdentifier)</RyuJitTargetRuntimeIdentifier>
    <RyuJitSubstitutionsFile>$(MSBuildProjectDirectory)\ILLink.Substitutions\ILLink.Substitutions.$(RyuJitTargetRuntimeIdentifier).xml</RyuJitSubstitutionsFile>
    <RyuJitLateDisasmSubstitutionsFile>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\ILLink.Substitutions.LATE_DISASM.$(RyuJitTargetRuntimeIdentifier).xml</RyuJitLateDisasmSubstitutionsFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="ILLink.Substitutions\*.xml" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <IlcArg Include="--substitution:&quot;$(RyuJitSubstitutionsFile)&quot;" />
    <IlcArg Include="--substitution:&quot;$(RyuJitLateDisasmSubstitutionsFile)&quot;" />
  </ItemGroup>

  <Target Name="ValidateRyuJitSubstitutions" BeforeTargets="PrepareForPublish" DependsOnTargets="WriteRyuJitLateDisasmSubstitution" Condition="'$(PublishAot)' == 'true'">
    <Error Condition="!Exists('$(RyuJitSubstitutionsFile)')" Text="No ILLink substitutions are defined for RyuJit target RID '$(RyuJitTargetRuntimeIdentifier)'." />
    <Error Condition="!Exists('$(RyuJitLateDisasmSubstitutionsFile)')" Text="No LATE_DISASM substitution was generated for RyuJit target RID '$(RyuJitTargetRuntimeIdentifier)'." />
  </Target>

  <Target Name="ValidateRyuJitGcTableVerificationConfiguration" BeforeTargets="CoreCompile">
    <Error Condition="'$(Configuration)' != 'Debug' and $(DefineConstants.Contains('VERIFY_GC_TABLES'))"
           Text="VERIFY_GC_TABLES requires the Debug configuration." />
  </Target>

  <Target Name="WriteRyuJitLateDisasmSubstitution" BeforeTargets="PrepareForPublish" Condition="'$(PublishAot)' == 'true'">
    <MakeDir Directories="$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)" />
    <WriteLinesToFile File="$(RyuJitLateDisasmSubstitutionsFile)" Lines="@(RyuJitLateDisasmSubstitutionLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- ILC tracks the response-file timestamp, not the external substitutions file itself. -->
  <Target Name="TrackRyuJitSubstitutionChanges"
          BeforeTargets="IlcCompile"
          DependsOnTargets="WriteRyuJitLateDisasmSubstitution"
          Inputs="$(RyuJitSubstitutionsFile);$(RyuJitLateDisasmSubstitutionsFile)"
          Outputs="$(IntermediateOutputPath)ILLink.Substitutions.$(RyuJitTargetRuntimeIdentifier).stamp"
          Condition="'$(PublishAot)' == 'true'">
    <Touch Files="@(ManagedBinary->'%(IlcRspFile)')" AlwaysCreate="true" />
    <Touch Files="$(IntermediateOutputPath)ILLink.Substitutions.$(RyuJitTargetRuntimeIdentifier).stamp" AlwaysCreate="true" />
  </Target>

  <!-- Extract the OS and architecture from the host runtime identifier -->

  <PropertyGroup>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-arm')) or $(RyuJitHostRuntimeIdentifier.Contains('-arm-'))">arm</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-armv6')) or $(RyuJitHostRuntimeIdentifier.Contains('-armv6-'))">armv6</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-arm64')) or $(RyuJitHostRuntimeIdentifier.Contains('-arm64-'))">arm64</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-loongarch64')) or $(RyuJitHostRuntimeIdentifier.Contains('-loongarch64-'))">loongarch64</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-mips64')) or $(RyuJitHostRuntimeIdentifier.Contains('-mips64-'))">mips64</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-ppc64le')) or $(RyuJitHostRuntimeIdentifier.Contains('-ppc64le-'))">ppc64le</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-riscv64')) or $(RyuJitHostRuntimeIdentifier.Contains('-riscv64-'))">riscv64</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-s390x')) or $(RyuJitHostRuntimeIdentifier.Contains('-s390x-'))">s390x</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-wasm')) or $(RyuJitHostRuntimeIdentifier.Contains('-wasm-'))">wasm</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-x64')) or $(RyuJitHostRuntimeIdentifier.Contains('-x64-'))">x64</RyuJitHostArchitecture>
    <RyuJitHostArchitecture Condition="$(RyuJitHostRuntimeIdentifier.EndsWith('-x86')) or $(RyuJitHostRuntimeIdentifier.Contains('-x86-'))">x86</RyuJitHostArchitecture>

    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('android'))">android</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('browser'))">browser</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('ios'))">ios</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('freebsd'))">freebsd</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('haiku'))">haiku</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('illumos'))">illumos</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('linux'))">linux</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('linux-musl'))">linux-musl</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('maccatalyst'))">maccatalyst</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('netbsd'))">netbsd</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('openbsd'))">openbsd</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('osx'))">osx</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('sunos'))">sunos</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('tvos'))">tvos</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('unix'))">unix</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('wasi'))">wasi</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('win'))">win</RyuJitHostOS>

    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'arm'">true</RyuJitHostIs32Bit>
    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'armv6'">true</RyuJitHostIs32Bit>
    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'wasm'">true</RyuJitHostIs32Bit>
    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'x86'">true</RyuJitHostIs32Bit>

    <RyuJitHostIs64Bit Condition="'$(RyuJitHostIs32Bit)' != 'true'">true</RyuJitHostIs64Bit>

    <RyuJitHostIsApple Condition="'$(RyuJitHostOS)' == 'ios'">true</RyuJitHostIsApple>
    <RyuJitHostIsApple Condition="'$(RyuJitHostOS)' == 'maccatalyst'">true</RyuJitHostIsApple>
    <RyuJitHostIsApple Condition="'$(RyuJitHostOS)' == 'osx'">true</RyuJitHostIsApple>
    <RyuJitHostIsApple Condition="'$(RyuJitHostOS)' == 'tvos'">true</RyuJitHostIsApple>

    <RyuJitHostIsArm Condition="'$(RyuJitHostArchitecture)' == 'arm'">true</RyuJitHostIsArm>
    <RyuJitHostIsArm Condition="'$(RyuJitHostArchitecture)' == 'armv6'">true</RyuJitHostIsArm>

    <RyuJitHostIsArmarch Condition="'$(RyuJitHostIsArm)' == 'true'">true</RyuJitHostIsArmarch>
    <RyuJitHostIsArmarch Condition="'$(RyuJitHostArchitecture)' == 'arm64'">true</RyuJitHostIsArmarch>

    <RyuJitHostIsUnix Condition="'$(RyuJitHostOS)' != 'win'">true</RyuJitHostIsUnix>

    <RyuJitHostIsXarch Condition="'$(RyuJitHostArchitecture)' == 'x86'">true</RyuJitHostIsXarch>
    <RyuJitHostIsXarch Condition="'$(RyuJitHostArchitecture)' == 'x64'">true</RyuJitHostIsXarch>
  </PropertyGroup>

  <!-- Extract the OS and architecture from the target runtime identifier -->

  <PropertyGroup>
    <RyuJitTargetArchitecture Condition="$(RyuJitTargetRuntimeIdentifier.EndsWith('-arm')) or $(RyuJitTargetRuntimeIdentifier.Contains('-arm-'))">arm</RyuJitTargetArchitecture>
