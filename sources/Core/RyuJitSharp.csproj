    <!--       call someFunc -->
    <!--       jmp/jcc RetBlock -->
    <!--       ... -->
    <!--    RetBlock: -->
    <!--       ret -->
    <DefineConstants Condition="'$(RyuJitTargetIsArmarch)' == 'true'">$(DefineConstants);FEATURE_TAILCALL_OPT_SHARED_RETURN</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'">$(DefineConstants);FEATURE_TAILCALL_OPT_SHARED_RETURN</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'">$(DefineConstants);FEATURE_TAILCALL_OPT_SHARED_RETURN</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'x64'">$(DefineConstants);FEATURE_TAILCALL_OPT_SHARED_RETURN</DefineConstants>

    <!-- FEATURE_PAL_ANSI -->
    <DefineConstants Condition="'$(RyuJitTargetIsUnix)' == 'true'">$(DefineConstants);FEATURE_PAL_ANSI</DefineConstants>

    <!-- FEATURE_SIMD -->
    <DefineConstants Condition="'$(RyuJitTargetIsXarch)' == 'true'">$(DefineConstants);FEATURE_SIMD</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'arm64'">$(DefineConstants);FEATURE_SIMD</DefineConstants>

    <!-- HAS_FIXED_REGISTER_SET -->
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' != 'wasm'">$(DefineConstants);HAS_FIXED_REGISTER_SET</DefineConstants>
    
    <!-- JIT32_GCENCODER -->
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'x86'">$(DefineConstants);JIT32_GCENCODER</DefineConstants>

    <!-- LOWER_DECOMPOSE_LONGS: Decompose TYP_LONG operations into (typically two) TYP_INT ones -->
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'arm'">$(DefineConstants);LOWER_DECOMPOSE_LONGS</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'x86'">$(DefineConstants);LOWER_DECOMPOSE_LONGS</DefineConstants>
    
    <!-- MULTIREG_HAS_SECOND_GC_RET -->
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'arm64'">$(DefineConstants);MULTIREG_HAS_SECOND_GC_RET</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'">$(DefineConstants);MULTIREG_HAS_SECOND_GC_RET</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'">$(DefineConstants);MULTIREG_HAS_SECOND_GC_RET</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' == 'true'">$(DefineConstants);MULTIREG_HAS_SECOND_GC_RET</DefineConstants>

    <!-- NOGC_WRITE_BARRIERS: We have specialized WriteBarrier JIT Helpers that DO-NOT trash the RBM_CALLEE_TRASH registers -->
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'arm64'">$(DefineConstants);NOGC_WRITE_BARRIERS</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'loongarch64'">$(DefineConstants);NOGC_WRITE_BARRIERS</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'riscv64'">$(DefineConstants);NOGC_WRITE_BARRIERS</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'x86'">$(DefineConstants);NOGC_WRITE_BARRIERS</DefineConstants>

    <!-- PROFILING_SUPPORTED -->
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' != 'wasm'">$(DefineConstants);PROFILING_SUPPORTED</DefineConstants>

    <!-- SWIFT_SUPPORT -->
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'arm64'">$(DefineConstants);SWIFT_SUPPORT</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetArchitecture)' == 'x64' and '$(RyuJitTargetIsUnix)' == 'true'">$(DefineConstants);SWIFT_SUPPORT</DefineConstants>
    
