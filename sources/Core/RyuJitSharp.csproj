    <DefineConstants Condition="'$(RyuJitHostArchitecture)' == 'arm64'">$(DefineConstants);HOST_ARM64</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostArchitecture)' == 'loongarch64'">$(DefineConstants);HOST_LOONGARCH64</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostArchitecture)' == 'mips64'">$(DefineConstants);HOST_MIPS64</DefineConstants>
    <DefineConstants Condition="'$(RyuJitHostArchitecture)' == 'ppc64le'">$(DefineConstants);HOST_POWERPC64</DefineConstants>
