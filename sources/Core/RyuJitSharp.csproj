    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('linux'))">linux</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('linux-musl'))">linux-musl</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('maccatalyst'))">maccatalyst</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('netbsd'))">netbsd</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('openbsd'))">openbsd</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('osx'))">osx</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('sunos'))">sunos</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('tvos'))">tvos</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('unix'))">unix</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('wasi'))">wasi</RyuJitHostOS>
    <RyuJitHostOS Condition="$(RyuJitHostRuntimeIdentifier.StartsWith('win'))">win</RyuJitHostOS>

    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'arm'">true</RyuJitHostIs32Bit>
    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'armv6'">true</RyuJitHostIs32Bit>
    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'wasm'">true</RyuJitHostIs32Bit>
    <RyuJitHostIs32Bit Condition="'$(RyuJitHostArchitecture)' == 'x86'">true</RyuJitHostIs32Bit>

    <RyuJitHostIs64Bit Condition="'$(RyuJitHostIs32Bit)' != 'true'">true</RyuJitHostIs64Bit>

    <RyuJitHostIsApple Condition="'$(RyuJitHostOS)' == 'ios'">true</RyuJitHostIsApple>
