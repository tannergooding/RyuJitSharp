    <RyuJitTargetArchitecture Condition="$(RyuJitTargetRuntimeIdentifier.EndsWith('-wasm')) or $(RyuJitTargetRuntimeIdentifier.Contains('-wasm-'))">wasm</RyuJitTargetArchitecture>
    <RyuJitTargetArchitecture Condition="$(RyuJitTargetRuntimeIdentifier.EndsWith('-x64')) or $(RyuJitTargetRuntimeIdentifier.Contains('-x64-'))">x64</RyuJitTargetArchitecture>
    <RyuJitTargetArchitecture Condition="$(RyuJitTargetRuntimeIdentifier.EndsWith('-x86')) or $(RyuJitTargetRuntimeIdentifier.Contains('-x86-'))">x86</RyuJitTargetArchitecture>

    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('android'))">android</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('browser'))">browser</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('ios'))">ios</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('freebsd'))">freebsd</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('haiku'))">haiku</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('illumos'))">illumos</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('linux'))">linux</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('linux-musl'))">linux-musl</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('maccatalyst'))">maccatalyst</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('netbsd'))">netbsd</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('openbsd'))">openbsd</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('osx'))">osx</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('sunos'))">sunos</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('tvos'))">tvos</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('unix'))">unix</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('wasi'))">wasi</RyuJitTargetOS>
    <RyuJitTargetOS Condition="$(RyuJitTargetRuntimeIdentifier.StartsWith('win'))">win</RyuJitTargetOS>

    <RyuJitTargetIs32Bit Condition="'$(RyuJitTargetArchitecture)' == 'arm'">true</RyuJitTargetIs32Bit>
    <RyuJitTargetIs32Bit Condition="'$(RyuJitTargetArchitecture)' == 'armv6'">true</RyuJitTargetIs32Bit>
    <RyuJitTargetIs32Bit Condition="'$(RyuJitTargetArchitecture)' == 'wasm'">true</RyuJitTargetIs32Bit>
    <RyuJitTargetIs32Bit Condition="'$(RyuJitTargetArchitecture)' == 'x86'">true</RyuJitTargetIs32Bit>

    <RyuJitTargetIs64Bit Condition="'$(RyuJitTargetIs32Bit)' != 'true'">true</RyuJitTargetIs64Bit>

    <RyuJitTargetIsApple Condition="'$(RyuJitTargetOS)' == 'ios'">true</RyuJitTargetIsApple>
    <RyuJitTargetIsApple Condition="'$(RyuJitTargetOS)' == 'maccatalyst'">true</RyuJitTargetIsApple>
    <RyuJitTargetIsApple Condition="'$(RyuJitTargetOS)' == 'osx'">true</RyuJitTargetIsApple>
    <RyuJitTargetIsApple Condition="'$(RyuJitTargetOS)' == 'tvos'">true</RyuJitTargetIsApple>

    <RyuJitTargetIsArm Condition="'$(RyuJitTargetArchitecture)' == 'arm'">true</RyuJitTargetIsArm>
    <RyuJitTargetIsArm Condition="'$(RyuJitTargetArchitecture)' == 'armv6'">true</RyuJitTargetIsArm>

    <RyuJitTargetIsArmarch Condition="'$(RyuJitTargetIsArm)' == 'true'">true</RyuJitTargetIsArmarch>
    <RyuJitTargetIsArmarch Condition="'$(RyuJitTargetArchitecture)' == 'arm64'">true</RyuJitTargetIsArmarch>

    <RyuJitTargetIsUnix Condition="'$(RyuJitTargetOS)' != 'win'">true</RyuJitTargetIsUnix>

    <RyuJitTargetIsXarch Condition="'$(RyuJitTargetArchitecture)' == 'x86'">true</RyuJitTargetIsXarch>
    <RyuJitTargetIsXarch Condition="'$(RyuJitTargetArchitecture)' == 'x64'">true</RyuJitTargetIsXarch>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants Condition="'$(RyuJitTargetIs64Bit)' == 'true'">$(DefineConstants);TARGET_64BIT</DefineConstants>
  </PropertyGroup>

  <!-- Defines that are on by default -->

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- DUMP_FLOWGRAPHS: Support for creating Xml Flowgraph reports in *.fgx files -->
    <DefineConstants>$(DefineConstants);DUMP_FLOWGRAPHS</DefineConstants>

    <!-- DUMP_GC_TABLES -->
    <DefineConstants>$(DefineConstants);DUMP_GC_TABLES</DefineConstants>

    <!-- TRACK_LSRA_STATS: Collect LSRA stats -->
    <DefineConstants>$(DefineConstants);TRACK_LSRA_STATS</DefineConstants>
    
  </PropertyGroup>

  <PropertyGroup>
    <RyuJitFeatureLateDisasm Condition="'$(Configuration)' == 'Debug' and ('$(RyuJitTargetIsArmarch)' == 'true' or '$(RyuJitTargetIsXarch)' == 'true')">true</RyuJitFeatureLateDisasm>
    <RyuJitFeatureLateDisasm Condition="'$(RyuJitTargetArchitecture)' == 'arm64' and '$(RyuJitEnableArm64LateDisasm)' == 'true'">true</RyuJitFeatureLateDisasm>
    <RyuJitFeatureLateDisasm Condition="'$(RyuJitFeatureLateDisasm)' == ''">false</RyuJitFeatureLateDisasm>
  </PropertyGroup>

  <ItemGroup>
    <RyuJitLateDisasmSubstitutionLine Include="&lt;linker&gt;" />
    <RyuJitLateDisasmSubstitutionLine Include="  &lt;assembly fullname=&quot;RyuJitSharp&quot;&gt;" />
    <RyuJitLateDisasmSubstitutionLine Include="    &lt;type fullname=&quot;RyuJitSharp.Configuration&quot;&gt;" />
    <RyuJitLateDisasmSubstitutionLine Include="      &lt;method signature=&quot;System.Boolean get_LATE_DISASM()&quot; body=&quot;stub&quot; value=&quot;$(RyuJitFeatureLateDisasm)&quot; /&gt;" />
    <RyuJitLateDisasmSubstitutionLine Include="    &lt;/type&gt;" />
    <RyuJitLateDisasmSubstitutionLine Include="  &lt;/assembly&gt;" />
    <RyuJitLateDisasmSubstitutionLine Include="&lt;/linker&gt;" />
  </ItemGroup>

  
  <!-- Defines that are off by default -->

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <!-- FEATURE_JIT_METHOD_PERF -->
    <!-- <DefineConstants>$(DefineConstants);FEATURE_JIT_METHOD_PERF</DefineConstants> -->
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- CSE_INTO_HANDLERS -->
    <!-- <DefineConstants>$(DefineConstants);CSE_INTO_HANDLERS</DefineConstants> -->

    <!-- VERIFY_GC_TABLES -->
    <!-- <DefineConstants>$(DefineConstants);VERIFY_GC_TABLES</DefineConstants> -->
  </PropertyGroup>

  <!-- Set these to 1 to enable optional statistics and diagnostic output. -->
  <PropertyGroup>
    <!-- DEBUG_EMIT: Enable detailed jump-emission diagnostics; requires debug instruction metadata. -->
    <!-- <DefineConstants>$(DefineConstants);DEBUG_EMIT</DefineConstants> -->

    <!-- CALL_ARG_STATS: Collect stats about calls and call arguments. -->
    <!-- <DefineConstants>$(DefineConstants);CALL_ARG_STATS</DefineConstants> -->

    <!-- COUNT_AST_OPERS: Display use counts for GenTree operators. -->
    <!-- <DefineConstants>$(DefineConstants);COUNT_AST_OPERS</DefineConstants> -->
    
    <!-- COUNT_BASIC_BLOCKS: Create a histogram of basic block sizes, and a histogram of IL sizes in the simple case of single block methods. -->
    <!-- <DefineConstants>$(DefineConstants);COUNT_BASIC_BLOCKS</DefineConstants> -->

    <!-- DISPLAY_SIZES: Display generated code, data, and GC information sizes. -->
    <!-- <DefineConstants>$(DefineConstants);DISPLAY_SIZES</DefineConstants> -->

    <!-- EMITTER_STATS: Collect stats on the emitter. -->
    <!-- <DefineConstants>$(DefineConstants);EMITTER_STATS</DefineConstants> -->

    <!-- FUNC_INFO_LOGGING: Enable per-function and NYI logging. -->
    <!-- <DefineConstants>$(DefineConstants);FUNC_INFO_LOGGING</DefineConstants> -->

    <!-- MEASURE_BLOCK_SIZE: Collect stats about basic block and FlowEdge node sizes and memory allocations. -->
    <!-- <DefineConstants>$(DefineConstants);MEASURE_BLOCK_SIZE</DefineConstants> -->

    <!-- MEASURE_FATAL: Enable runtime-gated counts of fatal calls, including NYIs and noway_asserts. -->
    <!-- <DefineConstants>$(DefineConstants);MEASURE_FATAL</DefineConstants> -->

    <!-- MEASURE_NODE_SIZE: Collect stats about GenTree node allocations. -->
    <!-- <DefineConstants>$(DefineConstants);MEASURE_NODE_SIZE</DefineConstants> -->

    <!-- JitMeasureNowayAssert enables the runtime-gated noway_assert occurrence map. -->

    <!-- MEASURE_PTRTAB_SIZE: Collect stats about GC pointer table allocations. -->
    <!-- <DefineConstants>$(DefineConstants);MEASURE_PTRTAB_SIZE</DefineConstants> -->

    <!-- NODEBASH_STATS: Collect stats on changed gtOper values in GenTree's. -->
    <!-- <DefineConstants>$(DefineConstants);NODEBASH_STATS</DefineConstants> -->
  </PropertyGroup>

</Project>
