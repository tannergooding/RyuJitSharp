    <DefineConstants Condition="'$(RyuJitTargetIsArm)' == 'true'">$(DefineConstants);TARGET_ARM</DefineConstants>
    <DefineConstants Condition="'$(RyuJitTargetIsArmarch)' == 'true'">$(DefineConstants);TARGET_ARMARCH</DefineConstants>
