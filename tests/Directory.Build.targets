<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Directory.Build.targets is automatically picked up and imported by
    Microsoft.Common.targets. This file needs to exist, even if empty so that
    files in the parent directory tree, with the same name, are not imported
    instead. The import fairly late and most other props/targets will have
    been imported beforehand. We also don't need to add ourselves to
    MSBuildAllProjects, as that is done by the file that imports us.
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.targets" />

  <!-- Untrimmed test hosts do not apply NativeAOT substitutions, so provide the target feature value in their runtimeconfig. -->
  <PropertyGroup>
    <RyuJitTestTargetRuntimeIdentifier Condition="'$(RyuJitTargetRuntimeIdentifier)' != ''">$(RyuJitTargetRuntimeIdentifier)</RyuJitTestTargetRuntimeIdentifier>
    <RyuJitTestTargetRuntimeIdentifier Condition="'$(RyuJitTestTargetRuntimeIdentifier)' == '' and '$(TargetRuntimeIdentifier)' != ''">$(TargetRuntimeIdentifier)</RyuJitTestTargetRuntimeIdentifier>
    <RyuJitTestTargetRuntimeIdentifier Condition="'$(RyuJitTestTargetRuntimeIdentifier)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RyuJitTestTargetRuntimeIdentifier>
    <RyuJitTestTargetRuntimeIdentifier Condition="'$(RyuJitTestTargetRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RyuJitTestTargetRuntimeIdentifier>
    <RyuJitFeatureHasZeroReg Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitFeatureHasZeroReg>
    <RyuJitFeatureHasZeroReg Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-loongarch64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-riscv64'))">true</RyuJitFeatureHasZeroReg>
    <RyuJitTargetIs64Bit Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIs64Bit>
    <RyuJitTargetIs64Bit Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-loongarch64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-mips64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-ppc64le')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-riscv64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-s390x')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-x64'))">true</RyuJitTargetIs64Bit>
    <RyuJitTargetIsArm Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsArm>
    <RyuJitTargetIsArm Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-armv6'))">true</RyuJitTargetIsArm>
    <RyuJitTargetIsArmV6 Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsArmV6>
    <RyuJitTargetIsArmV6 Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-armv6'))">true</RyuJitTargetIsArmV6>
    <RyuJitTargetIsArm64 Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsArm64>
    <RyuJitTargetIsArm64 Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm64'))">true</RyuJitTargetIsArm64>
    <RyuJitTargetIsArmArch Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsArmArch>
    <RyuJitTargetIsArmArch Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-armv6')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm64'))">true</RyuJitTargetIsArmArch>
    <RyuJitTargetIsLoongArch64 Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsLoongArch64>
    <RyuJitTargetIsLoongArch64 Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-loongarch64'))">true</RyuJitTargetIsLoongArch64>
    <RyuJitTargetIsRiscV64 Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsRiscV64>
    <RyuJitTargetIsRiscV64 Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-riscv64'))">true</RyuJitTargetIsRiscV64>
    <RyuJitTargetIsXarch Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsXarch>
    <RyuJitTargetIsXarch Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-x64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-x86'))">true</RyuJitTargetIsXarch>
    <RyuJitTargetIsWasm Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsWasm>
    <RyuJitTargetIsWasm Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-wasm'))">true</RyuJitTargetIsWasm>
    <RyuJitTargetIsWindows Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsWindows>
    <RyuJitTargetIsWindows Condition="$(RyuJitTestTargetRuntimeIdentifier.StartsWith('win-'))">true</RyuJitTargetIsWindows>
    <RyuJitWindowsAmd64Abi Condition="'$(RyuJitTestTargetRuntimeIdentifier)' == 'win-x64'">true</RyuJitWindowsAmd64Abi>
    <RyuJitWindowsAmd64Abi Condition="'$(RyuJitWindowsAmd64Abi)' == ''">false</RyuJitWindowsAmd64Abi>
    <RyuJitTargetIsUnix Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">true</RyuJitTargetIsUnix>
    <RyuJitTargetIsUnix Condition="$(RyuJitTestTargetRuntimeIdentifier.StartsWith('win-'))">false</RyuJitTargetIsUnix>
    <RyuJitTargetIsApple Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsApple>
    <RyuJitTargetIsApple Condition="$(RyuJitTestTargetRuntimeIdentifier.StartsWith('osx-')) or $(RyuJitTestTargetRuntimeIdentifier.StartsWith('ios-')) or $(RyuJitTestTargetRuntimeIdentifier.StartsWith('tvos-')) or $(RyuJitTestTargetRuntimeIdentifier.StartsWith('maccatalyst-'))">true</RyuJitTargetIsApple>
    <RyuJitTargetOSRuntimeDetermined Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetOSRuntimeDetermined>
    <RyuJitUnixOSRuntimeDetermined Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitUnixOSRuntimeDetermined>
    <RyuJitUnixX86Abi Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitUnixX86Abi>
    <RyuJitUnixX86Abi Condition="$(RyuJitTestTargetRuntimeIdentifier.StartsWith('linux-')) and $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-x86'))">true</RyuJitUnixX86Abi>
    <RyuJitUnixX86Abi Condition="'$(RyuJitUnixX86Abi)' == ''">false</RyuJitUnixX86Abi>
    <RyuJitFeatureSimd Condition="'$(RyuJitTargetIsXarch)' == 'true' or '$(RyuJitTargetIsArm64)' == 'true' or '$(RyuJitTargetIsWasm)' == 'true'">true</RyuJitFeatureSimd>
    <RyuJitFeatureSimd Condition="'$(RyuJitFeatureSimd)' == ''">false</RyuJitFeatureSimd>
    <RyuJitFeatureHwIntrinsics Condition="'$(RyuJitTargetIsXarch)' == 'true' or '$(RyuJitTargetIsArm64)' == 'true' or '$(RyuJitTargetIsWasm)' == 'true'">true</RyuJitFeatureHwIntrinsics>
    <RyuJitFeatureHwIntrinsics Condition="'$(RyuJitFeatureHwIntrinsics)' == ''">false</RyuJitFeatureHwIntrinsics>
    <RyuJitFeatureMaskedHwIntrinsics Condition="'$(RyuJitTargetIsXarch)' == 'true' or '$(RyuJitTargetIsArm64)' == 'true'">true</RyuJitFeatureMaskedHwIntrinsics>
    <RyuJitFeatureMaskedHwIntrinsics Condition="'$(RyuJitFeatureMaskedHwIntrinsics)' == ''">false</RyuJitFeatureMaskedHwIntrinsics>
    <RyuJitFeatureLoopAlign Condition="'$(RyuJitTargetIsXarch)' == 'true' or '$(RyuJitTargetIsArm64)' == 'true'">true</RyuJitFeatureLoopAlign>
    <RyuJitFeatureLoopAlign Condition="'$(RyuJitFeatureLoopAlign)' == ''">false</RyuJitFeatureLoopAlign>
    <RyuJitFeatureMultiRegRet Condition="'$(RyuJitTargetIsArmArch)' == 'true' or '$(RyuJitTargetIsLoongArch64)' == 'true' or '$(RyuJitTargetIsRiscV64)' == 'true'">true</RyuJitFeatureMultiRegRet>
    <RyuJitFeatureMultiRegRet Condition="'$(RyuJitTargetIsXarch)' == 'true' and '$(RyuJitTargetIs64Bit)' == 'true' and '$(RyuJitTargetIsUnix)' == 'true'">true</RyuJitFeatureMultiRegRet>
    <RyuJitFeatureMultiRegRet Condition="'$(RyuJitTargetIsXarch)' == 'true' and '$(RyuJitTargetIs64Bit)' != 'true'">true</RyuJitFeatureMultiRegRet>
    <RyuJitFeatureMultiRegRet Condition="'$(RyuJitFeatureMultiRegRet)' == ''">false</RyuJitFeatureMultiRegRet>
    <RyuJitFeatureReadyToRun>true</RyuJitFeatureReadyToRun>
    <RyuJitFeatureVnDumpFuncArgs Condition="'$(RyuJitFeatureVnDumpFuncArgs)' == ''">false</RyuJitFeatureVnDumpFuncArgs>
    <RyuJitFeatureArmSoftFp Condition="'$(RyuJitFeatureArmSoftFp)' == ''">false</RyuJitFeatureArmSoftFp>
    <RyuJitFeatureLateDisasm Condition="'$(Configuration)' == 'Debug' and ('$(RyuJitTargetIsArmArch)' == 'true' or '$(RyuJitTargetIsXarch)' == 'true')">true</RyuJitFeatureLateDisasm>
    <RyuJitFeatureLateDisasm Condition="'$(RyuJitTargetIsArm64)' == 'true' and '$(RyuJitEnableArm64LateDisasm)' == 'true'">true</RyuJitFeatureLateDisasm>
    <RyuJitFeatureLateDisasm Condition="'$(RyuJitFeatureLateDisasm)' == ''">false</RyuJitFeatureLateDisasm>
    <RyuJitFeatureDisasmDebug Condition="'$(RyuJitFeatureDisasmDebug)' == ''">false</RyuJitFeatureDisasmDebug>
    <RyuJitFeatureProfilingSupported Condition="'$(RyuJitTargetIsWasm)' != 'true' or '$(RyuJitEnableWasmProfilingTests)' == 'true'">true</RyuJitFeatureProfilingSupported>
    <RyuJitFeatureProfilingSupported Condition="'$(RyuJitFeatureProfilingSupported)' == ''">false</RyuJitFeatureProfilingSupported>
  </PropertyGroup>

  <ItemGroup Condition="'$(RyuJitFeatureHasZeroReg)' != '' and '$(RyuJitTargetIs64Bit)' != '' and '$(RyuJitTargetIsArm)' != '' and '$(RyuJitTargetIsArmV6)' != '' and '$(RyuJitTargetIsArm64)' != '' and '$(RyuJitTargetIsArmArch)' != '' and '$(RyuJitTargetIsLoongArch64)' != '' and '$(RyuJitTargetIsRiscV64)' != '' and '$(RyuJitTargetIsXarch)' != '' and '$(RyuJitTargetIsWasm)' != '' and '$(RyuJitTargetIsWindows)' != '' and '$(RyuJitWindowsAmd64Abi)' != '' and '$(RyuJitTargetIsUnix)' != '' and '$(RyuJitTargetIsApple)' != '' and '$(RyuJitTargetOSRuntimeDetermined)' != '' and '$(RyuJitUnixOSRuntimeDetermined)' != '' and '$(RyuJitFeatureSimd)' != '' and '$(RyuJitFeatureHwIntrinsics)' != '' and '$(RyuJitFeatureMaskedHwIntrinsics)' != '' and '$(RyuJitFeatureLoopAlign)' != '' and '$(RyuJitFeatureMultiRegRet)' != '' and '$(RyuJitFeatureVnDumpFuncArgs)' != '' and '$(RyuJitFeatureArmSoftFp)' != '' and '$(RyuJitUnixX86Abi)' != '' and '$(RyuJitFeatureLateDisasm)' != '' and '$(RyuJitFeatureDisasmDebug)' != '' and '$(RyuJitFeatureProfilingSupported)' != ''">
    <RuntimeHostConfigurationOption Include="RyuJitSharp.FEATURE_HW_INTRINSICS" Value="$(RyuJitFeatureHwIntrinsics)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.FEATURE_MASKED_HW_INTRINSICS" Value="$(RyuJitFeatureMaskedHwIntrinsics)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.FEATURE_HAS_ZERO_REG" Value="$(RyuJitFeatureHasZeroReg)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.FEATURE_MULTIREG_RET" Value="$(RyuJitFeatureMultiRegRet)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.FEATURE_SIMD" Value="$(RyuJitFeatureSimd)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.FEATURE_LOOP_ALIGN" Value="$(RyuJitFeatureLoopAlign)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.FEATURE_READYTORUN" Value="$(RyuJitFeatureReadyToRun)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.FEATURE_VN_DUMP_FUNC_ARGS" Value="$(RyuJitFeatureVnDumpFuncArgs)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.FEATURE_ON_STACK_REPLACEMENT" Value="true" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.ARM_SOFTFP" Value="$(RyuJitFeatureArmSoftFp)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_64BIT" Value="$(RyuJitTargetIs64Bit)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_ARM" Value="$(RyuJitTargetIsArm)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_ARMV6" Value="$(RyuJitTargetIsArmV6)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_ARM64" Value="$(RyuJitTargetIsArm64)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_ARMARCH" Value="$(RyuJitTargetIsArmArch)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_LOONGARCH64" Value="$(RyuJitTargetIsLoongArch64)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_RISCV64" Value="$(RyuJitTargetIsRiscV64)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_XARCH" Value="$(RyuJitTargetIsXarch)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_WASM" Value="$(RyuJitTargetIsWasm)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_WINDOWS" Value="$(RyuJitTargetIsWindows)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_UNIX" Value="$(RyuJitTargetIsUnix)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_APPLE" Value="$(RyuJitTargetIsApple)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.WINDOWS_AMD64_ABI" Value="$(RyuJitWindowsAmd64Abi)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_OS_RUNTIMEDETERMINED" Value="$(RyuJitTargetOSRuntimeDetermined)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_UNIX_OS_RUNTIMEDETERMINED" Value="$(RyuJitUnixOSRuntimeDetermined)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.UNIX_X86_ABI" Value="$(RyuJitUnixX86Abi)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.LATE_DISASM" Value="$(RyuJitFeatureLateDisasm)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.DISASM_DEBUG" Value="$(RyuJitFeatureDisasmDebug)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.PROFILING_SUPPORTED" Value="$(RyuJitFeatureProfilingSupported)" />
  </ItemGroup>

</Project>
