<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Directory.Build.targets is automatically picked up and imported by
    Microsoft.Common.targets. This file needs to exist, even if empty so that
    files in the parent directory tree, with the same name, are not imported
    instead. The import fairly late and most other props/targets will have
    been imported beforehand. We also don't need to add ourselves to
    MSBuildAllProjects, as that is done by the file that imports us.
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.targets" />

  <!-- Untrimmed test hosts do not apply NativeAOT substitutions, so provide the target feature value in their runtimeconfig. -->
  <PropertyGroup>
    <RyuJitTestTargetRuntimeIdentifier Condition="'$(RyuJitTargetRuntimeIdentifier)' != ''">$(RyuJitTargetRuntimeIdentifier)</RyuJitTestTargetRuntimeIdentifier>
    <RyuJitTestTargetRuntimeIdentifier Condition="'$(RyuJitTestTargetRuntimeIdentifier)' == '' and '$(TargetRuntimeIdentifier)' != ''">$(TargetRuntimeIdentifier)</RyuJitTestTargetRuntimeIdentifier>
    <RyuJitTestTargetRuntimeIdentifier Condition="'$(RyuJitTestTargetRuntimeIdentifier)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RyuJitTestTargetRuntimeIdentifier>
    <RyuJitTestTargetRuntimeIdentifier Condition="'$(RyuJitTestTargetRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RyuJitTestTargetRuntimeIdentifier>
    <RyuJitFeatureHasZeroReg Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitFeatureHasZeroReg>
    <RyuJitFeatureHasZeroReg Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-loongarch64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-riscv64'))">true</RyuJitFeatureHasZeroReg>
    <RyuJitTargetIs64Bit Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIs64Bit>
    <RyuJitTargetIs64Bit Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-loongarch64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-mips64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-ppc64le')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-riscv64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-s390x')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-x64'))">true</RyuJitTargetIs64Bit>
    <RyuJitTargetIsArm Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsArm>
    <RyuJitTargetIsArm Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm'))">true</RyuJitTargetIsArm>
    <RyuJitTargetIsArm64 Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsArm64>
    <RyuJitTargetIsArm64 Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm64'))">true</RyuJitTargetIsArm64>
    <RyuJitTargetIsArmArch Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsArmArch>
    <RyuJitTargetIsArmArch Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-arm64'))">true</RyuJitTargetIsArmArch>
    <RyuJitTargetIsLoongArch64 Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsLoongArch64>
    <RyuJitTargetIsLoongArch64 Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-loongarch64'))">true</RyuJitTargetIsLoongArch64>
    <RyuJitTargetIsRiscV64 Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsRiscV64>
    <RyuJitTargetIsRiscV64 Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-riscv64'))">true</RyuJitTargetIsRiscV64>
    <RyuJitTargetIsXarch Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsXarch>
    <RyuJitTargetIsXarch Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-x64')) or $(RyuJitTestTargetRuntimeIdentifier.EndsWith('-x86'))">true</RyuJitTargetIsXarch>
    <RyuJitTargetIsWasm Condition="'$(RyuJitTestTargetRuntimeIdentifier)' != ''">false</RyuJitTargetIsWasm>
    <RyuJitTargetIsWasm Condition="$(RyuJitTestTargetRuntimeIdentifier.EndsWith('-wasm'))">true</RyuJitTargetIsWasm>
  </PropertyGroup>

  <ItemGroup Condition="'$(RyuJitFeatureHasZeroReg)' != '' and '$(RyuJitTargetIs64Bit)' != '' and '$(RyuJitTargetIsArm)' != '' and '$(RyuJitTargetIsArm64)' != '' and '$(RyuJitTargetIsArmArch)' != '' and '$(RyuJitTargetIsLoongArch64)' != '' and '$(RyuJitTargetIsRiscV64)' != '' and '$(RyuJitTargetIsXarch)' != '' and '$(RyuJitTargetIsWasm)' != ''">
    <RuntimeHostConfigurationOption Include="RyuJitSharp.FEATURE_HAS_ZERO_REG" Value="$(RyuJitFeatureHasZeroReg)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_64BIT" Value="$(RyuJitTargetIs64Bit)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_ARM" Value="$(RyuJitTargetIsArm)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_ARM64" Value="$(RyuJitTargetIsArm64)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_ARMARCH" Value="$(RyuJitTargetIsArmArch)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_LOONGARCH64" Value="$(RyuJitTargetIsLoongArch64)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_RISCV64" Value="$(RyuJitTargetIsRiscV64)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_XARCH" Value="$(RyuJitTargetIsXarch)" />
    <RuntimeHostConfigurationOption Include="RyuJitSharp.TARGET_WASM" Value="$(RyuJitTargetIsWasm)" />
  </ItemGroup>

  <Target Name="GetRyuJitCompileConstants" BeforeTargets="CoreCompile">
    <MSBuild Projects="@(ProjectReference)" Targets="GetRyuJitCompileConstants" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_RyuJitCompileConstants" />
    </MSBuild>
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);@(_RyuJitCompileConstants)</DefineConstants>
    </PropertyGroup>
  </Target>

</Project>
