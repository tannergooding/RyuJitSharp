<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sources\Core\RyuJitSharp.csproj" />
    <Compile Include="..\Core\AbiPassingInformationTests.cs" Link="AbiPassingInformationTests.cs" />
    <Compile Include="..\Core\ArmCalleeSavedRegisterTests.cs" Link="ArmCalleeSavedRegisterTests.cs" />
    <Compile Include="..\Core\Arm64*Tests.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\Core\CSELiveAcrossCallCostTests.cs" Link="CSELiveAcrossCallCostTests.cs" />
    <Compile Include="..\Core\EnumUtilityTests.cs" Link="EnumUtilityTests.cs" />
    <Compile Include="..\Core\HWIntrinsicCodegenClassificationTests.cs" Link="HWIntrinsicCodegenClassificationTests.cs" />
    <Compile Include="..\Core\HWIntrinsicXplatImportTests.cs" Link="HWIntrinsicXplatImportTests.cs" />
    <Compile Include="..\Core\SwiftAbiTests.cs" Link="SwiftAbiTests.cs" />
    <Compile Include="..\Core\SysVX64ClassifierTests.cs" Link="SysVX64ClassifierTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="$(RyuJitTargetRuntimeIdentifier.EndsWith('-arm64')) or ('$(RyuJitTargetRuntimeIdentifier)' == '' and $(TargetRuntimeIdentifier.EndsWith('-arm64')))">
    <Compile Include="..\Core\CodeGenLabelTests.cs" Link="CodeGenLabelTests.cs" />
    <Compile Include="..\Core\ControlFlowGuardLoweringTests.cs" Link="ControlFlowGuardLoweringTests.cs" />
    <Compile Include="..\Core\PInvokeCallLoweringTests.cs" Link="PInvokeCallLoweringTests.cs" />
    <Compile Include="..\Core\PInvokeFrameLoweringTests.cs" Link="PInvokeFrameLoweringTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="$(RyuJitTargetRuntimeIdentifier.EndsWith('-arm64')) or ('$(RyuJitTargetRuntimeIdentifier)' == '' and $(TargetRuntimeIdentifier.EndsWith('-arm64'))) or ('$(RyuJitTargetRuntimeIdentifier)' == 'linux-x64') or ('$(RyuJitTargetRuntimeIdentifier)' == '' and '$(TargetRuntimeIdentifier)' == 'linux-x64')">
    <Compile Include="..\Core\FastTailCallLoweringTests.cs" Link="FastTailCallLoweringTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RyuJitTargetRuntimeIdentifier)' == 'linux-x64' or ('$(RyuJitTargetRuntimeIdentifier)' == '' and '$(TargetRuntimeIdentifier)' == 'linux-x64')">
    <Compile Include="..\Core\SysVX64LocalStoreLoweringTests.cs" Link="SysVX64LocalStoreLoweringTests.cs" />
    <Compile Include="..\Core\LinuxX64EmitterBranchPaddingTests.cs" Link="LinuxX64EmitterBranchPaddingTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RyuJitTargetRuntimeIdentifier)' == 'win-x86' or ('$(RyuJitTargetRuntimeIdentifier)' == '' and '$(TargetRuntimeIdentifier)' == 'win-x86')">
    <Compile Include="..\Core\X86EmitterStaticFieldDependencyTests.cs" Link="X86EmitterStaticFieldDependencyTests.cs" />
    <Compile Include="..\Core\X86EmitterStaticOutputTests.cs" Link="X86EmitterStaticOutputTests.cs" />
    <Compile Include="..\Core\X86EmitterAddressStackOutputTests.cs" Link="X86EmitterAddressStackOutputTests.cs" />
    <Compile Include="..\Core\X86EmitterRegisterImmediateOutputTests.cs" Link="X86EmitterRegisterImmediateOutputTests.cs" />
    <Compile Include="..\Core\X86EmitterInstructionDispatchTests.cs" Link="X86EmitterInstructionDispatchTests.cs" />
    <Compile Include="..\Core\X86EmitterPaddingOutputTests.cs" Link="X86EmitterPaddingOutputTests.cs" />
  </ItemGroup>

  <PropertyGroup Condition="$(RyuJitTargetRuntimeIdentifier.EndsWith('-wasm')) or ('$(RyuJitTargetRuntimeIdentifier)' == '' and $(TargetRuntimeIdentifier.EndsWith('-wasm')))">
    <DefineConstants>$(DefineConstants);TARGET_WASM</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="$(RyuJitTargetRuntimeIdentifier.EndsWith('-wasm')) or ('$(RyuJitTargetRuntimeIdentifier)' == '' and $(TargetRuntimeIdentifier.EndsWith('-wasm')))">
    <Compile Include="..\Core\WasmCallArgumentMorphTests.cs" Link="WasmCallArgumentMorphTests.cs" />
    <Compile Include="..\Core\WasmClassifierTests.cs" Link="WasmClassifierTests.cs" />
  </ItemGroup>

</Project>
